# Example Environment Configuration for Kedami Frontend
# Copy this file to .env or .env.local for local development
# In production (e.g. Vercel), set these in your project's Environment Variables dashboard.

# API Base URL (leave empty for same-origin proxy or specify your backend endpoint)
VITE_API_URL=http://127.0.0.1:8000

# Platform Super Admin Email (optional override)
VITE_ADMIN_EMAIL=admin@kedami.et
