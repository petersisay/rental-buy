# Kedami Express Backend Environment Configuration
# Copy this file to .env for local development

# Server Port
PORT=8000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI (Atlas or Local)
# In production (e.g. Render), set MONGODB_URI in your Render Dashboard Environment Variables
MONGODB_URI=mongodb://127.0.0.1:27017/kedami

# Platform Super Admin Email
ADMIN_EMAIL=admin@kedami.et
